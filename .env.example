# Copy to .env and replace every change-me value. .env is gitignored.
POSTGRES_USER=app
POSTGRES_DB=app
# Avoid URL-special characters (@ : / ? #) in POSTGRES_PASSWORD; it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me
# JWT_SECRET must be at least 32 bytes, e.g. generated with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_TTL=1h
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
